@page "/Forum"
@rendermode InteractiveServer

<PageTitle>Forum - PaddockF1</PageTitle>

<h2>Forum</h2>

@* todo : filtre + recherche *@

<div class="uk-grid-small" uk-grid>
    @foreach (var topic in _topics)
    {
        <div class="uk-card uk-card-small uk-card-body uk-card-default uk-width uk-child-width-1-3" uk-grid>
            <h5 class="uk-card-title">@topic.Title</h5>
            <div uk-grid>
                @* todo: groupe de tags*@
                @* @foreach (var tag in topic.Tags) *@
                @* { *@
                <span class="uk-border-pill uk-padding-small" style="border: 1px solid red;">
                    @* tag *@
                    Carlos Sainz
                </span>
                @* } *@
            </div>
            <div>
                <div class="uk-margin-auto-left uk-width-1-2">
                    <span>Créé le @topic.CreatedAt.ToString("dd MMMM yyyy")</span>
                </div>
            </div>
        </div>
    }
</div>
@page "/TopicDetail/{id}"
@rendermode InteractiveServer

<PageTitle>@_topic!.Title - PaddockF1</PageTitle>

<h2>@_topic!.Title</h2>

@* Liste tags *@

<p>@_topic.Description</p>

<div class="uk-grid-small uk-child-width" uk-grid>
    @foreach (var message in _topic.Messages)
    {
        <div class="uk-card uk-card-default">
            <div class="uk-card-header">
                <h5>@message.User.UserName</h5>
                @* todo: user null (voir relations) *@
            </div>
            <div class="uk-card-body">
                <p>@message.Content</p>
            </div>
        </div>
    }
</div>
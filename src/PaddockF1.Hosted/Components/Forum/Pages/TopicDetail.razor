@page "/forum/{id}"
@using System.Globalization
@using PaddockF1.Hosted.Components.Forum.Components

@rendermode InteractiveServer

<PageTitle>@_topic!.Title - PaddockF1</PageTitle>

<div class="uk-flex uk-flex-between">
    <h2>@_topic!.Title</h2>

    <AuthorizeView>
        <Authorized>
            @if (_topic.Author == _user || _userRoles.Contains("Admin"))
            {
                <div class="uk-grid-large uk-width-1-3" uk-grid>
                    <div>
                        <button class="uk-button uk-button-secondary uk-height-1-1 uk-border-rounded"
                                uk-toggle="target: #modal-creation" type="button">
                            <span uk-icon="icon: pencil"></span>
                        </button>
                    </div>
                    <div>
                        <button class="uk-button uk-button-primary uk-height-1-1 uk-border-rounded"
                                uk-toggle="target: #modal-confirm-delete">
                            <span uk-icon="icon: trash"></span>
                        </button>
                    </div>
                </div>
            }
        </Authorized>
    </AuthorizeView>
</div>

<TopicForm InputModel="_topic"/>

@if (_userRoles.Contains("Admin") || _topic.Author == _user)
{
    <div id="modal-confirm-delete" uk-modal>
        <div class="uk-modal-body uk-modal-dialog">
            <h4 class="uk-modal-title">
                Confirmation de suppression
            </h4>
            <p>
                Êtes-vous sûr de vouloir supprimer ce sujet de discussion ?
            </p>
            <div class="uk-flex uk-flex-between">
                <button class="uk-button uk-button-secondary uk-border-rounded uk-modal-close">
                    Annuler
                </button>
                <button class="uk-button uk-button-primary uk-border-rounded" @onclick="DeleteTopic">
                    Supprimer
                </button>
            </div>
        </div>
    </div>
}

@* Liste tags *@

<p>@_topic.Description</p>

<div class="uk-grid-small uk-child-width" uk-grid>
    @foreach (var message in _topic.Messages)
    {
        <div class="uk-card uk-card-small uk-card-default">
            <div class="uk-card-header">
                <h5>@message.User.UserName</h5>
                <p class="uk-text-meta">
                    Envoyé
                    le @message.CreatedAt.ToString("d MMMM yyyy à H:mm", CultureInfo.CreateSpecificCulture("fr-FR"))
                </p>
            </div>
            <div class="uk-card-body">
                <p>@message.Content</p>
            </div>
        </div>
    }

    <AuthorizeView Context="authContext">
        <Authorized>
            <EditForm Model="@Model" OnSubmit="Callback" class="uk-padding-remove uk-margin">
                <InputTextArea class="uk-textarea" placeholder="Ecrivez votre message ici..."
                               @bind-Value="Model.Content" style="resize: vertical"/>
                <button type="submit" class="uk-button uk-button-primary uk-margin">Envoyer</button>
            </EditForm>
        </Authorized>
        <NotAuthorized>
            <a href="/Account/Login" class="uk-button uk-button-primary uk-border-rounded uk-margin">
                Si vous souhaitez interagir dans ce forum, connectez-vous ici
            </a>
        </NotAuthorized>
    </AuthorizeView>

</div>
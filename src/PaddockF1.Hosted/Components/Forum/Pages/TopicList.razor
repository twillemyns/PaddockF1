@page "/forum"
@rendermode InteractiveServer

<PageTitle>Forum - PaddockF1</PageTitle>

<h2>Forum</h2>

<AuthorizeView>
    <Authorized>
        <button uk-toggle="target: #modal-creation" class="uk-button uk-button-primary uk-border-rounded uk-margin">Créer un nouveau sujet de discussion</button>
    </Authorized>
</AuthorizeView>

<div id="modal-creation" uk-modal>
    <div class="uk-modal-body uk-modal-dialog">
        <h4 class="uk-modal-title">
            Création d'un nouveau sujet de discussion
        </h4>
        <EditForm class="uk-form-stacked" Model="NewTopic" OnValidSubmit="CreateTopic">
            <DataAnnotationsValidator />
            <div class="uk-margin">
                <label class="uk-form-label">Titre :</label>
                <InputText class="uk-input" @bind-Value="@NewTopic.Title"/>
                <ValidationMessage For="() => NewTopic.Title" class="uk-text-danger"/>
            </div>
            <div class="uk-margin">
                <label class="uk-form-label">Description :</label>
                <InputTextArea class="uk-textarea" @bind-Value="@NewTopic.Description" style="resize: vertical"/>
                <ValidationMessage For="() => NewTopic.Description" class="uk-text-danger"/>
            </div>
            <button type="submit" class="uk-button uk-button-primary uk-border-rounded">Créer</button>
        </EditForm>
    </div>
</div>

@* todo : filtre + recherche *@

<div class="uk-grid-small uk-child-width" uk-grid>
    @foreach (var topic in _topics)
    {
        <div>
            <a class="uk-link-reset" href="/forum/@topic.Id.ToString()">
                <div class="uk-card uk-card-small uk-card-body uk-card-default uk-width uk-child-width-1-3" uk-grid style="align-items: center">
                    <h5 class="uk-card-title">@topic.Title</h5>
                    <div uk-grid >
                        @* todo: groupe de tags*@
                        @* @foreach (var tag in topic.Tags) *@
                        @* { *@
                        @* <span class="uk-border-pill uk-padding-small" style="border: 1px solid red;"> *@
                        @*     $1$ tag #1# *@
                        @*     Carlos Sainz *@
                        @* </span> *@
                        @* } *@
                    </div>
                    <div>
                        <div class="uk-margin-auto-left uk-width-1-2">
                            <span>Créé le @topic.CreatedAt.ToString("dd MMMM yyyy")</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>
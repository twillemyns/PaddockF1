@inherits LayoutComponentBase

@implements IDisposable
@inject NavigationManager NavigationManager

<div class="body">
    <div>
        <header>
            <nav class="uk-navbar-container uk-navbar-primary uk-navbar" style="padding: 0 20px 0 20px; height: 80px" uk-navbar>
                <div class="uk-navbar-left">
                    <ul class="uk-navbar-nav">
                        <li><a>Pilotes</a></li>
                        <li><a>Ecuries</a></li>
                        <li><a>Calendrier</a></li>
                        <li><a href="/forum">Forum</a></li>
                    </ul>
                </div>
                <div class="uk-navbar-center">
                    <a class="uk-navbar-item uk-logo" href="/">
                        <h1 style="font-family: Payback,serif; font-size: 50px">PaddockF1</h1>
                    </a>
                </div>
                <div class="uk-navbar-right">
                    <ul class="uk-navbar-nav">
                        <AuthorizeView>
                            <Authorized>
                                <li>
                                    <button class="uk-button uk-button-primary uk-border-rounded">
                                        <NavLink class="uk-link-reset" href="Account/Manage">
                                            Mon compte
                                        </NavLink>
                                    </button>
                                </li>
                                <li>
                                    <form action="Account/Logout" method="post">
                                        <AntiforgeryToken/>
                                        <input type="hidden" name="ReturnUrl" value="@_currentUrl"/>
                                        <button type="submit" class="uk-button uk-button-primary uk-border-rounded">
                                            Se déconnecter
                                        </button>
                                    </form>
                                </li>
                            </Authorized>
                            <NotAuthorized>
                                <li>
                                    <NavLink href="Account/Login">
                                        <button class="uk-button uk-button-primary uk-border-rounded">Se connecter</button>
                                    </NavLink>
                                </li>
                                <li>
                                    <NavLink href="Account/Register">
                                        <button class="uk-button uk-button-primary uk-border-rounded">S'inscrire</button>
                                    </NavLink>
                                </li>
                            </NotAuthorized>
                        </AuthorizeView>
                    </ul>
                </div>
            </nav>
        </header>
        <main class="uk-container uk-margin-top">
            @Body
        </main>
    </div>

    <footer>
        <div class="uk-navbar-container uk-padding-small uk-navbar" style="padding: 20px 40px 20px 40px; bottom: 0; background-color: #2d2d2d" uk-navbar>
            <div class="uk-navbar-left">
                <a href="/" class="uk-navbar-item uk-logo uk-link-muted" style="font-family: Payback,serif; font-size: 30px">PaddockF1</a>
            </div>
            <div class="uk-navbar-center">
                <ul class="uk-margin-remove uk-list uk-link-muted">
                    <li >
                        <a href="#">Pilotes</a>
                    </li>
                    <li class="uk-margin-remove">
                        <a href="#">Ecuries</a>
                    </li>
                    <li class="uk-margin-remove">
                        <a href="#">Calendrier</a>
                    </li>
                    <li class="uk-margin-remove">
                        <a href="/forum">Forum</a>
                    </li>
                </ul>
            </div>
            <div class="uk-navbar-right">
                <ul class="uk-margin-remove uk-list uk-link-muted">
                    <li class="uk-margin-remove">
                        <a href="#">Mentions légales</a>
                    </li>
                    <li class="uk-margin-remove">
                        <a href="#">Contact</a>
                    </li>
                </ul>
            </div>
        </div>
    </footer>
</div>

@code
{
    private string? _currentUrl;

    protected override void OnInitialized()
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
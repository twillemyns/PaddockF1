@page "/"

<PageTitle>Accueil - PaddockF1</PageTitle>

<h2>Forum</h2>

<div class="uk-grid-small uk-child-width" uk-grid>
    @foreach (var topic in Topics)
    {
        <div>
            <a class="uk-link-reset" href="/forum/@topic.Id.ToString()">
                <div class="uk-card uk-card-small uk-card-body uk-card-default uk-width uk-child-width-1-3" uk-grid>
                    <span class="uk-card-title">
                        <span class="uk-text-middle">@topic.Title</span>
                    </span>
                    <div uk-grid>
                        @* todo: groupe de tags*@
                        @* @foreach (var tag in topic.Tags) *@
                        @* { *@
                        <span class="uk-border-pill uk-padding-small" style="border: 1px solid red;">
                            @* tag *@
                            Carlos Sainz
                        </span>
                        @* } *@
                    </div>
                    <div>
                        <div class="uk-margin-auto-left uk-width-1-2">
                            <span class="uk-text-middle">Créé le @topic.CreatedAt.ToString("dd MMMM yyyy")</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    }
    <div class="uk-flex uk-flex-center">
        <a href="/forum" class="uk-button uk-button-primary uk-border-rounded uk-margin-top">Voir plus</a>
    </div>
</div>
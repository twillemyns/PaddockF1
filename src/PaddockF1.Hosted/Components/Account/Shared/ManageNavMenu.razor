@using Microsoft.AspNetCore.Identity
@using PaddockF1.Hosted.Data

@inject SignInManager<ApplicationUser> SignInManager

<ul class="uk-nav uk-nav-default uk-flex-column">
    <li class="">
        <NavLink class="uk-nav-link" href="Account/Manage" Match="NavLinkMatch.All">Profil</NavLink>
    </li>
    <li class="">
        <NavLink class="uk-nav-link" href="Account/Manage/Email">Email</NavLink>
    </li>
    <li class="">
        <NavLink class="uk-nav-link" href="Account/Manage/ChangePassword">Mot de passe</NavLink>
    </li>
    @if (hasExternalLogins)
    {
        <li class="">
            <NavLink class="uk-nav-link" href="Account/Manage/ExternalLogins">Connexions externes</NavLink>
        </li>
    }
    <li class="">
        <NavLink class="uk-nav-link" href="Account/Manage/TwoFactorAuthentication">Authentification à 2 facteurs</NavLink>
    </li>
    <li class="">
        <NavLink class="uk-nav-link" href="Account/Manage/PersonalData">Données personnelles</NavLink>
    </li>
</ul>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}

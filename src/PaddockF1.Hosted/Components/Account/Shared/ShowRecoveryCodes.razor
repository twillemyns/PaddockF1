<StatusMessage Message="@StatusMessage" />
<h3>Codes de récupération</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <strong>Enregistrez ces codes dans un endroit sécurisé.</strong>
    </p>
    <p>
        Si vous perdez votre appareil et que vous n'avez pas les codes de récupération, vous perdrez l'accès à votre compte.
    </p>
</div>
<div class="row">
    <div class="col-md-12">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <div>
                <code class="recovery-code">@recoveryCode</code>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}

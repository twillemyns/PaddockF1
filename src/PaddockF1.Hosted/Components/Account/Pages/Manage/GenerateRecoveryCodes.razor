@page "/Account/Manage/GenerateRecoveryCodes"

@using Microsoft.AspNetCore.Identity
@using PaddockF1.Hosted.Data
@using PaddockF1.Hosted.Data.Models

@inject UserManager<ApplicationUser> UserManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<GenerateRecoveryCodes> Logger

<PageTitle>Générer des codes de récupération d'authentification à deux facteurs (2FA)</PageTitle>

@if (recoveryCodes is not null)
{
    <ShowRecoveryCodes RecoveryCodes="recoveryCodes.ToArray()" StatusMessage="@message" />
}
else
{
    <h3>Générer des codes de récupération d'authentification à deux facteurs (2FA</h3>
    <div class="uk-alert uk-alert-warning" role="alert">
        <p>
            <span class="glyphicon glyphicon-warning-sign"></span>
            <strong>Enregistrez ces codes dans un lieu sécurisé.</strong>
        </p>
        <p>
            Si vous perdez votre appareil et que vous n'avez pas les codes de récupération, vous perdrez l'accès à votre compte.
        </p>
        <p>
            Generating new recovery codes does not change the keys used in authenticator apps. If you wish to change the key
            used in an authenticator app you should <a href="Account/Manage/ResetAuthenticator">reset your authenticator keys.</a>
            @* en français *@
            Générer de nouveaux codes de récupération ne change pas les clés utilisées dans les applications d'authentification. Si vous souhaitez changer la clé
            utilisée dans une application d'authentification, vous devez <a href="Account/Manage/ResetAuthenticator">réinitialiser vos clés d'authentification.</a>
        </p>
    </div>
    <div>
        <form @formname="generate-recovery-codes" @onsubmit="OnSubmitAsync" method="post">
            <AntiforgeryToken />
            <button class="uk-button uk-button-danger" type="submit">Générer des codes de récupération</button>
        </form>
    </div>
}

@code {
    private string? message;
    private ApplicationUser user = default!;
    private IEnumerable<string>? recoveryCodes;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);

        var isTwoFactorEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        if (!isTwoFactorEnabled)
        {
            throw new InvalidOperationException("Ne peut pas générer de codes de récupération pour l'utilisateur car il n'a pas activé l'authentification à deux facteurs.");
        }
    }

    private async Task OnSubmitAsync()
    {
        var userId = await UserManager.GetUserIdAsync(user);
        recoveryCodes = await UserManager.GenerateNewTwoFactorRecoveryCodesAsync(user, 10);
        message = "Vous avez généré de nouveaux codes de récupération.";

        Logger.LogInformation("L'utilisateur avec l'ID '{UserId}' a généré des codes de récupération pour l'authentification à 2 facteurs.", userId);
    }
}

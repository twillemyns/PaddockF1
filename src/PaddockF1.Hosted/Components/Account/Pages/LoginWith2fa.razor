@page "/Account/LoginWith2fa"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using PaddockF1.Hosted.Data
@using PaddockF1.Hosted.Data.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<LoginWith2fa> Logger

<PageTitle>Authentification à 2 facteurs</PageTitle>
@* TODO: Faire le CSS de la page une fois l'authentification à 2 facteurs mise en place *@
<h2>Authentification à 2 facteurs</h2>
<hr />
<StatusMessage Message="@message" />
<p>Votre connexion est protégée par une application d'authentification. Entrez votre code d'authentification ci-dessous.</p>
<div class="row">
    <div class="col-md-4">
        <EditForm Model="Input" FormName="login-with-2fa" OnValidSubmit="OnValidSubmitAsync" method="post">
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <input type="hidden" name="RememberMe" value="@RememberMe" />
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.TwoFactorCode" class="form-control" autocomplete="off" />
                <label for="two-factor-code" class="form-label">Code d'authentification</label>
                <ValidationMessage For="() => Input.TwoFactorCode" class="text-danger" />
            </div>
            <div class="checkbox mb-3">
                <label for="remember-machine" class="form-label">
                    <InputCheckbox @bind-Value="Input.RememberMachine" />
                    Se souvenir de cette machine
                </label>
            </div>
            <div>
                <button type="submit" class="w-100 btn btn-lg btn-primary">Se connecter</button>
            </div>
        </EditForm>
    </div>
</div>
<p>
    Pas accès à votre application d'authentification? Vous pouvez
    <a href="Account/LoginWithRecoveryCode?ReturnUrl=@ReturnUrl">vous connecter avec un code de récupération</a>.
</p>

@code {
    private string? message;
    private ApplicationUser user = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private bool RememberMe { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Ensure the user has gone through the username & password screen first
        user = await SignInManager.GetTwoFactorAuthenticationUserAsync() ??
            throw new InvalidOperationException("Impossible de charger l'utilisateur via l'authentification à 2 facteurs.");
    }

    private async Task OnValidSubmitAsync()
    {
        var authenticatorCode = Input.TwoFactorCode!.Replace(" ", string.Empty).Replace("-", string.Empty);
        var result = await SignInManager.TwoFactorAuthenticatorSignInAsync(authenticatorCode, RememberMe, Input.RememberMachine);
        var userId = await UserManager.GetUserIdAsync(user);

        if (result.Succeeded)
        {
            Logger.LogInformation("L'utilisateur avec l'id: '{UserId}' est connecté via 2fa.", userId);
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("L'utilisateur avec l'id: '{UserId}' a son compte bloqué.", userId);
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            Logger.LogWarning("Code d'authentification invalide pour l'utilisateur avec l'ID: '{UserId}'.", userId);
            message = "Erreur: Code d'authentification invalide. Veuillez réessayer.";
        }
    }

    private sealed class InputModel
    {
        [Required]
        [StringLength(7, ErrorMessage = "Le {0} dot avoir au minimum {2} caractères et au maximum {1} caractères.", MinimumLength = 6)]
        [DataType(DataType.Text)]
        [Display(Name = "Code d'authentification")]
        public string? TwoFactorCode { get; set; }

        [Display(Name = "Se souvenir de cette machine")]
        public bool RememberMachine { get; set; }
    }
}
